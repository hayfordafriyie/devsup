{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DevSup": "Data Source=devsup.db"
  },
  "Jwt": {
    "Issuer": "devsup",
    "Audience": "devsup-clients",
    "SecretKey": "dev-only-secret-key-do-not-use-in-production-change-me-please-123456"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 25,
    "Username": "",
    "Password": "",
    "From": "devsup@localhost",
    "FromName": "DevSup",
    "EnableSsl": false,
    "TimeoutSeconds": 30
  },
  "Emailing": {
    "IntervalSeconds": 15,
    "BatchSize": 25,
    "MaxAttempts": 5
  },
  "Security": {
    "DataProtectionKey": "devsup-dev-only-data-protection-key-change-in-production"
  },
  "Repairing": {
    "IntervalSeconds": 20,
    "BatchSize": 5,
    "GitUserName": "DevSup Bot",
    "GitUserEmail": "devsup@localhost"
  },
  "GitHub": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "/api/auth/github/callback",
    "Scope": "repo user:email"
  },
  "GitLab": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "/api/auth/gitlab/callback",
    "Scope": "read_user api"
  },
  "AiModels": {
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "llama3.2",
      "TimeoutSeconds": 120
    }
  }
}